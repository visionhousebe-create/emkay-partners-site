# Copier en .env.local pour le développement. Sur Vercel : Project → Settings → Environment Variables.

# Facultatif : remplace la destination des messages du formulaire (par défaut : Formspree https://formspree.io/f/xdarzqyq).
# Autre Formspree, Make / n8n / Zapier (« Catch Hook ») ou Slack (« Incoming Webhook », champ `text`).
CONTACT_WEBHOOK_URL=

# Facultatif : surcharge du domaine canonique (par défaut en production : https://www.emkaypartners.com).
NEXT_PUBLIC_SITE_URL=

