# Copier en .env.local pour le développement. Sur Vercel : Project → Settings → Environment Variables.

# URL qui reçoit les messages du formulaire de contact (POST JSON).
# Make / n8n / Zapier : URL du « webhook » / « Catch Hook ». Slack : URL d'un « Incoming Webhook » (champ `text`).
# Sans cette variable : le visiteur voit une confirmation, mais le message n'est que journalisé côté serveur.
CONTACT_WEBHOOK_URL=

# Facultatif : surcharge du domaine canonique (par défaut en production : https://www.emkaypartners.com).
NEXT_PUBLIC_SITE_URL=
